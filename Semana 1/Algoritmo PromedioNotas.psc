Algoritmo PromedioNotas
	Definir nota_1, nota_2, nota_3 Como Real
	Definir promedio_notas Como Real
	Definir suma_notas Como Real
	Escribir 'Ingresa la primer nota'
	Leer nota_1
	Escribir 'Ingresa la segunda nota'
	Leer nota_2
	Escribir 'Ingresa la tercera nota'
	Leer nota_3
	suma_notas = nota_1 + nota_2 + nota_3 
	promedio_notas = suma_notas / 3
	Escribir 'Tu promedio es : ' promedio_notas
FinAlgoritmo
